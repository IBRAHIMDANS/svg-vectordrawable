{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2022"],
        "types": ["node"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "skipLibCheck": true,
        "declaration": true,
        "outDir": "dist",
        "rootDir": ".",
        "verbatimModuleSyntax": true
    },
    "include": ["src", "example/vite.config.ts"]
}
