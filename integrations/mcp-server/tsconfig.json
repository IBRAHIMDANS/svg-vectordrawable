{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2022"],
        "types": ["node"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "skipLibCheck": true,
        "verbatimModuleSyntax": true,
        "rootDir": "src",
        "outDir": "dist"
    },
    "include": ["src"]
}
