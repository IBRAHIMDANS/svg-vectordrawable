import androidx.compose.ui.unit.dp

val ClipPath: ImageVector by lazy {
    ImageVector.Builder(
        name = "ClipPath",
        defaultWidth = 24.dp,
        defaultHeight = 24.dp,
        viewportWidth = 24f,
        viewportHeight = 24f,
