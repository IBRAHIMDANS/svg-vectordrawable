{
    "name": "svg-vectordrawable",
    "version": "0.3.0",
    "description": "Convert SVG to Android VectorDrawable XML. AST-based (via svgo), with gradients (incl. gradientTransform), clip-path, groups and full CSS color support. Fails loud on constructs a VectorDrawable cannot represent.",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.cts",
    "typesVersions": {
        "*": {
            "browser": [
                "./dist/browser.d.ts"
            ],
            "browser-lite": [
                "./dist/browser-lite.d.ts"
            ]
        }
    },
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./browser": {
            "types": "./dist/browser.d.ts",
            "import": "./dist/browser.js"
        },
        "./browser-lite": {
            "types": "./dist/browser-lite.d.ts",
            "import": "./dist/browser-lite.js"
        }
    },
    "bin": {
        "svgvd": "dist/cli.js"
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "tsup",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:visual": "vitest run test/visual.test.ts",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "validate:aapt2": "node scripts/aapt2-validate.mjs",
        "validate:corpus": "node scripts/corpus.mjs",
        "validate:wpt": "node scripts/wpt-corpus.mjs",
        "validate:android": "node android-render/prepare.mjs && cd android-render && ./gradlew :render:testDebugUnitTest --console=plain && cd .. && node android-render/compare.mjs",
        "validate": "pnpm run build && pnpm run validate:aapt2 && pnpm run validate:corpus",
        "prepublishOnly": "pnpm run build",
        "release": "npm publish --provenance --access public"
    },
    "keywords": [
        "svg",
        "android",
        "vectordrawable",
        "vector-drawable",
        "android-vector-drawable",
        "drawable",
        "svg-to-vectordrawable",
        "svg2vectordrawable",
        "svg2vector",
        "svg-converter",
        "gradient",
        "gradientTransform",
        "clip-path",
        "figma",
        "converter",
        "cli",
        "svgo"
    ],
    "license": "MIT",
    "author": "Ibrahima Dansoko <ibrahimdansoko@gmail.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/IBRAHIMDANS/svg-vectordrawable.git"
    },
    "homepage": "https://github.com/IBRAHIMDANS/svg-vectordrawable#readme",
    "bugs": {
        "url": "https://github.com/IBRAHIMDANS/svg-vectordrawable/issues"
    },
    "packageManager": "pnpm@12.18.0",
    "engines": {
        "node": ">=18"
    },
    "dependencies": {
        "svgo": "^4.1.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@resvg/resvg-js": "^2.6.2",
        "@types/node": "^26.6.6",
        "@vitest/coverage-v8": "^5.1.0",
        "eslint": "^10.14.0",
        "globals": "^17.14.0",
        "prettier": "^3.9.10",
        "tsup": "^9.0.0",
        "typescript": "^5.6.0",
        "typescript-eslint": "^8.72.2",
        "vitest": "^5.1.0"
    }
}
